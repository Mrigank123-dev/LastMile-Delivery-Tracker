 55…tableorder_status_historyorder_status_historyCREATE TABLE order_status_history (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  order_id INTEGER NOT NULL,
  status TEXT NOT NULL,
  actor_id INTEGER,
  actor_role TEXT,
  note TEXT,
